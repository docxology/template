2026-11-03T05:15:20.5164746Z set -euo pipefail
2026-11-03T05:15:20.5165384Z pins=$(python3 -S - <<'PY'
2026-11-03T05:15:20.5165651Z import ast
2026-11-03T05:15:20.5165856Z import re
2026-11-03T05:15:20.5166078Z from pathlib import Path
2026-11-03T05:15:20.5166331Z 
2026-11-03T05:15:20.5166574Z fields = {"TLC_URL", "TLC_SHA256", "TLC_BYTES"}
2026-11-03T05:15:20.5167248Z tree = ast.parse(Path("projects/templates/template_formal/src/template_formal/tool_acceptance.py").read_text(encoding="utf-8"))
2026-11-03T05:15:20.5167874Z values = {}
2026-11-03T05:15:20.5168104Z for node in ast.walk(tree):
2026-11-03T05:15:20.5168535Z     if isinstance(node, (ast.Assign, ast.AnnAssign, ast.AugAssign, ast.NamedExpr)):
2026-11-03T05:15:20.5169106Z         targets = node.targets if isinstance(node, ast.Assign) else [node.target]
2026-11-03T05:15:20.5169765Z         selected = {item.id for target in targets for item in ast.walk(target) if isinstance(item, ast.Name)} & fields
2026-11-03T05:15:20.5170290Z         if selected:
2026-11-03T05:15:20.5170693Z             if not (isinstance(node, ast.Assign) and node in tree.body and len(targets) == 1
2026-11-03T05:15:20.5171300Z                     and isinstance(targets[0], ast.Name) and isinstance(node.value, ast.Constant)):
2026-11-03T05:15:20.5172119Z                 raise SystemExit("TLC pins require unique simple top-level literal assignments")
2026-11-03T05:15:20.5172608Z             name = targets[0].id
2026-11-03T05:15:20.5172894Z             if name in values:
2026-11-03T05:15:20.5173277Z                 raise SystemExit("TLC pin is declared more than once: " + name)
2026-11-03T05:15:20.5173697Z             values[name] = node.value.value
2026-11-03T05:15:20.5173993Z if set(values) != fields:
2026-11-03T05:15:20.5174327Z     raise SystemExit("TLC source pin tuple is incomplete")
2026-11-03T05:15:20.5175094Z url, digest, size = values["TLC_URL"], values["TLC_SHA256"], values["TLC_BYTES"]
2026-11-03T05:15:20.5175906Z if type(url) is not str or re.fullmatch(r"https://github\.com/tlaplus/tlaplus/releases/download/[A-Za-z0-9._-]+/tla2tools\.jar", url) is None:
2026-11-03T05:15:20.5176684Z     raise SystemExit("TLC URL must be an exact HTTPS official release locator")
2026-11-03T05:15:20.5177237Z if type(digest) is not str or re.fullmatch(r"[0-9a-f]{64}", digest) is None:
2026-11-03T05:15:20.5177784Z     raise SystemExit("TLC SHA256 must be 64 lowercase hexadecimal characters")
2026-11-03T05:15:20.5178272Z if type(size) is not int or not 0 < size <= 64 * 1024 * 1024:
2026-11-03T05:15:20.5178825Z     raise SystemExit("TLC byte length must be a positive integer within the existing 64 MiB bound")
2026-11-03T05:15:20.5179309Z print(url, digest, size)
2026-11-03T05:15:20.5179558Z PY
2026-11-03T05:15:20.5179746Z )
2026-11-03T05:15:20.5180006Z read -r url expected_sha expected_bytes <<< "$pins"
2026-11-03T05:15:20.5180435Z tool=$(mktemp -d "$RUNNER_TEMP/template-tlc-tools.XXXXXX")
2026-11-03T05:15:20.5180794Z jar="$tool/tla2tools.jar"
2026-11-03T05:15:20.5181296Z curl --fail --location --proto '=https' --proto-redir '=https' --retry 2 --max-time 120 --output "$jar" "$url"
2026-11-03T05:15:20.5181883Z actual_bytes=$(wc -c < "$jar" | tr -d '[:space:]')
2026-11-03T05:15:20.5182438Z if [ "$actual_bytes" != "$expected_bytes" ]; then
2026-11-03T05:15:20.5182976Z   printf 'TLC byte length mismatch: expected %s, got %s\n' "$expected_bytes" "$actual_bytes" >&2
2026-11-03T05:15:20.5183443Z   exit 1
2026-11-03T05:15:20.5183645Z fi
2026-11-03T05:15:20.5183872Z actual_sha=$(shasum -a 256 "$jar")
2026-11-03T05:15:20.5184166Z actual_sha=${actual_sha%% *}
2026-11-03T05:15:20.5184468Z if [ "$actual_sha" != "$expected_sha" ]; then
2026-11-03T05:15:20.5185082Z   printf 'TLC SHA256 mismatch: expected %s, got %s\n' "$expected_sha" "$actual_sha" >&2
2026-11-03T05:15:20.5185520Z   exit 1
2026-11-03T05:15:20.5185713Z fi
2026-11-03T05:15:20.5185966Z echo "TEMPLATE_FORMAL_TLC_JAR=$jar" >> "$GITHUB_ENV"
