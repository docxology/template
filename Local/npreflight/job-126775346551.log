2026-11-04T18:28:47.8245024Z ##[start-action display=Prepare the exact authenticated TLC tool input;id=__self_2.__run_2]
2026-11-04T18:28:47.8266514Z ##[group]Run set -euo pipefail
2026-11-04T18:28:47.8266848Z set -euo pipefail
2026-11-04T18:28:47.8267404Z pins=$(python3 -S - <<'PY'
2026-11-04T18:28:47.8267686Z import ast
2026-11-04T18:28:47.8267900Z import re
2026-11-04T18:28:47.8268123Z from pathlib import Path
2026-11-04T18:28:47.8268379Z 
2026-11-04T18:28:47.8268632Z fields = {"TLC_URL", "TLC_SHA256", "TLC_BYTES"}
2026-11-04T18:28:47.8269294Z tree = ast.parse(Path("projects/templates/template_formal/src/template_formal/tool_acceptance.py").read_text(encoding="utf-8"))
2026-11-04T18:28:47.8269910Z values = {}
2026-11-04T18:28:47.8270148Z for node in ast.walk(tree):
2026-11-04T18:28:47.8270579Z     if isinstance(node, (ast.Assign, ast.AnnAssign, ast.AugAssign, ast.NamedExpr)):
2026-11-04T18:28:47.8271321Z         targets = node.targets if isinstance(node, ast.Assign) else [node.target]
2026-11-04T18:28:47.8271983Z         selected = {item.id for target in targets for item in ast.walk(target) if isinstance(item, ast.Name)} & fields
2026-11-04T18:28:47.8272501Z         if selected:
2026-11-04T18:28:47.8272900Z             if not (isinstance(node, ast.Assign) and node in tree.body and len(targets) == 1
2026-11-04T18:28:47.8273532Z                     and isinstance(targets[0], ast.Name) and isinstance(node.value, ast.Constant)):
2026-11-04T18:28:47.8274166Z                 raise SystemExit("TLC pins require unique simple top-level literal assignments")
2026-11-04T18:28:47.8274633Z             name = targets[0].id
2026-11-04T18:28:47.8274913Z             if name in values:
2026-11-04T18:28:47.8275292Z                 raise SystemExit("TLC pin is declared more than once: " + name)
2026-11-04T18:28:47.8275726Z             values[name] = node.value.value
2026-11-04T18:28:47.8276028Z if set(values) != fields:
2026-11-04T18:28:47.8276361Z     raise SystemExit("TLC source pin tuple is incomplete")
2026-11-04T18:28:47.8276841Z url, digest, size = values["TLC_URL"], values["TLC_SHA256"], values["TLC_BYTES"]
2026-11-04T18:28:47.8277914Z if type(url) is not str or re.fullmatch(r"https://github\.com/tlaplus/tlaplus/releases/download/[A-Za-z0-9._-]+/tla2tools\.jar", url) is None:
2026-11-04T18:28:47.8278691Z     raise SystemExit("TLC URL must be an exact HTTPS official release locator")
2026-11-04T18:28:47.8279223Z if type(digest) is not str or re.fullmatch(r"[0-9a-f]{64}", digest) is None:
2026-11-04T18:28:47.8279767Z     raise SystemExit("TLC SHA256 must be 64 lowercase hexadecimal characters")
2026-11-04T18:28:47.8280258Z if type(size) is not int or not 0 < size <= 64 * 1024 * 1024:
2026-11-04T18:28:47.8280810Z     raise SystemExit("TLC byte length must be a positive integer within the existing 64 MiB bound")
2026-11-04T18:28:47.8281304Z print(url, digest, size)
2026-11-04T18:28:47.8281549Z PY
2026-11-04T18:28:47.8281740Z )
2026-11-04T18:28:47.8282011Z read -r url expected_sha expected_bytes <<< "$pins"
2026-11-04T18:28:47.8282468Z tool=$(mktemp -d "$RUNNER_TEMP/template-tlc-tools.XXXXXX")
2026-11-04T18:28:47.8282829Z jar="$tool/tla2tools.jar"
2026-11-04T18:28:47.8283323Z curl --fail --location --proto '=https' --proto-redir '=https' --retry 2 --max-time 120 --output "$jar" "$url"
2026-11-04T18:28:47.8283899Z actual_bytes=$(wc -c < "$jar" | tr -d '[:space:]')
2026-11-04T18:28:47.8284275Z if [ "$actual_bytes" != "$expected_bytes" ]; then
2026-11-04T18:28:47.8284777Z   printf 'TLC byte length mismatch: expected %s, got %s\n' "$expected_bytes" "$actual_bytes" >&2
2026-11-04T18:28:47.8285242Z   exit 1
2026-11-04T18:28:47.8285433Z fi
2026-11-04T18:28:47.8285787Z actual_sha=$(shasum -a 256 "$jar")
2026-11-04T18:28:47.8286089Z actual_sha=${actual_sha%% *}
2026-11-04T18:28:47.8286391Z if [ "$actual_sha" != "$expected_sha" ]; then
2026-11-04T18:28:47.8286850Z   printf 'TLC SHA256 mismatch: expected %s, got %s\n' "$expected_sha" "$actual_sha" >&2
2026-11-04T18:28:47.8287549Z   exit 1
2026-11-04T18:28:47.8287741Z fi
2026-11-04T18:28:47.8287992Z echo "TEMPLATE_FORMAL_TLC_JAR=$jar" >> "$GITHUB_ENV"
