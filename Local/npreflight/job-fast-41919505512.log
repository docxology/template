2026-11-04T21:49:28.7582435Z ##[start-action display=Prepare the exact authenticated TLC tool input;id=__self_2.__run_2]
2026-11-04T21:49:28.7602437Z ##[group]Run set -euo pipefail
2026-11-04T21:49:28.7602944Z set -euo pipefail
2026-11-04T21:49:28.7603212Z pins=$(python3 -S - <<'PY'
2026-11-04T21:49:28.7603494Z import ast
2026-11-04T21:49:28.7603706Z import re
2026-11-04T21:49:28.7603930Z from pathlib import Path
2026-11-04T21:49:28.7604180Z 
2026-11-04T21:49:28.7604430Z fields = {"TLC_URL", "TLC_SHA256", "TLC_BYTES"}
2026-11-04T21:49:28.7605092Z tree = ast.parse(Path("projects/templates/template_formal/src/template_formal/tool_acceptance.py").read_text(encoding="utf-8"))
2026-11-04T21:49:28.7605707Z values = {}
2026-11-04T21:49:28.7605935Z for node in ast.walk(tree):
2026-11-04T21:49:28.7606367Z     if isinstance(node, (ast.Assign, ast.AnnAssign, ast.AugAssign, ast.NamedExpr)):
2026-11-04T21:49:28.7607073Z         targets = node.targets if isinstance(node, ast.Assign) else [node.target]
2026-11-04T21:49:28.7608032Z         selected = {item.id for target in targets for item in ast.walk(target) if isinstance(item, ast.Name)} & fields
2026-11-04T21:49:28.7608579Z         if selected:
2026-11-04T21:49:28.7608988Z             if not (isinstance(node, ast.Assign) and node in tree.body and len(targets) == 1
2026-11-04T21:49:28.7609598Z                     and isinstance(targets[0], ast.Name) and isinstance(node.value, ast.Constant)):
2026-11-04T21:49:28.7610227Z                 raise SystemExit("TLC pins require unique simple top-level literal assignments")
2026-11-04T21:49:28.7610686Z             name = targets[0].id
2026-11-04T21:49:28.7610967Z             if name in values:
2026-11-04T21:49:28.7611353Z                 raise SystemExit("TLC pin is declared more than once: " + name)
2026-11-04T21:49:28.7611796Z             values[name] = node.value.value
2026-11-04T21:49:28.7612101Z if set(values) != fields:
2026-11-04T21:49:28.7612447Z     raise SystemExit("TLC source pin tuple is incomplete")
2026-11-04T21:49:28.7612935Z url, digest, size = values["TLC_URL"], values["TLC_SHA256"], values["TLC_BYTES"]
2026-11-04T21:49:28.7613734Z if type(url) is not str or re.fullmatch(r"https://github\.com/tlaplus/tlaplus/releases/download/[A-Za-z0-9._-]+/tla2tools\.jar", url) is None:
2026-11-04T21:49:28.7614513Z     raise SystemExit("TLC URL must be an exact HTTPS official release locator")
2026-11-04T21:49:28.7615050Z if type(digest) is not str or re.fullmatch(r"[0-9a-f]{64}", digest) is None:
2026-11-04T21:49:28.7615585Z     raise SystemExit("TLC SHA256 must be 64 lowercase hexadecimal characters")
2026-11-04T21:49:28.7616066Z if type(size) is not int or not 0 < size <= 64 * 1024 * 1024:
2026-11-04T21:49:28.7616610Z     raise SystemExit("TLC byte length must be a positive integer within the existing 64 MiB bound")
2026-11-04T21:49:28.7617109Z print(url, digest, size)
2026-11-04T21:49:28.7617358Z PY
2026-11-04T21:49:28.7617676Z )
2026-11-04T21:49:28.7617954Z read -r url expected_sha expected_bytes <<< "$pins"
2026-11-04T21:49:28.7618382Z tool=$(mktemp -d "$RUNNER_TEMP/template-tlc-tools.XXXXXX")
2026-11-04T21:49:28.7618747Z jar="$tool/tla2tools.jar"
2026-11-04T21:49:28.7619256Z curl --fail --location --proto '=https' --proto-redir '=https' --retry 2 --max-time 120 --output "$jar" "$url"
2026-11-04T21:49:28.7619834Z actual_bytes=$(wc -c < "$jar" | tr -d '[:space:]')
2026-11-04T21:49:28.7620240Z if [ "$actual_bytes" != "$expected_bytes" ]; then
2026-11-04T21:49:28.7620747Z   printf 'TLC byte length mismatch: expected %s, got %s\n' "$expected_bytes" "$actual_bytes" >&2
2026-11-04T21:49:28.7621209Z   exit 1
2026-11-04T21:49:28.7621411Z fi
2026-11-04T21:49:28.7621628Z actual_sha=$(shasum -a 256 "$jar")
2026-11-04T21:49:28.7621919Z actual_sha=${actual_sha%% *}
2026-11-04T21:49:28.7622375Z if [ "$actual_sha" != "$expected_sha" ]; then
2026-11-04T21:49:28.7622843Z   printf 'TLC SHA256 mismatch: expected %s, got %s\n' "$expected_sha" "$actual_sha" >&2
2026-11-04T21:49:28.7623277Z   exit 1
2026-11-04T21:49:28.7623475Z fi
2026-11-04T21:49:28.7623729Z echo "TEMPLATE_FORMAL_TLC_JAR=$jar" >> "$GITHUB_ENV"
