2026-11-04T21:50:03.8133669Z   fi
2026-11-04T21:50:03.8133888Z   "$chrome" --version
2026-11-04T21:50:03.8134223Z   echo "CHROME_EXECUTABLE_PATH=$chrome" >> "$GITHUB_ENV"
2026-11-04T21:50:03.8134587Z   sudo apt-get update
2026-11-04T21:50:03.8134913Z   sudo apt-get install -y --no-install-recommends \
