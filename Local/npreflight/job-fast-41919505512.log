2026-11-04T21:50:03.8130308Z if [ "$RUNNER_OS" = Linux ]; then
2026-11-04T21:50:03.8130714Z   # The runner also exposes a development Chromium snapshot. Native
2026-11-04T21:50:03.8131417Z   # observations need the installed Google Chrome runtime and sandbox.
2026-11-04T21:50:03.8131841Z   chrome=/opt/google/chrome/chrome
