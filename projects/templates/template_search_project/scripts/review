#!/usr/bin/env python3
"""Run the selected project review under finite whole-review and stage deadlines."""

from __future__ import annotations

import sys
from pathlib import Path

# Admit the selected platform before exposing the own domain source.
import infrastructure  # noqa: F401

_project_root = Path(__file__).resolve().parent.parent
sys.path.insert(0, str(_project_root / "src"))

from template_search_project.analysis.review_execution import review_cli  # noqa: E402


def main() -> int:
    """Thin entry point; own domain code resolves and executes the review."""
    return review_cli(_project_root / "src")


if __name__ == "__main__":
    sys.exit(main())
