#!/usr/bin/env python3
"""Run the selected project review under finite whole-review and stage deadlines."""

from __future__ import annotations

import sys
from pathlib import Path

_project_root = Path(__file__).resolve().parent.parent
# Select the declared SDK before exposing domain source; no ancestor imports.
_original_import_paths = sys.path[:]
try:
    sys.path.insert(0, str(_project_root / "scripts"))
    from _search_sdk_bootstrap import select_platform_sdk

    select_platform_sdk(_project_root)
finally:
    sys.path[:] = _original_import_paths
sys.path.insert(0, str(_project_root / "src"))

from template_search_project.analysis.review_execution import review_cli  # noqa: E402


def main() -> int:
    """Thin entry point; own domain code resolves and executes the review."""
    return review_cli(_project_root / "src")


if __name__ == "__main__":
    sys.exit(main())
